# Discord Bot Credentials
# Copy this file to .env and fill in your values
# NEVER commit your real .env file

DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Discord OAuth2 (Dashboard login)
# Application ID — usually same as CLIENT_ID
DISCORD_CLIENT_ID=
# Bot / OAuth2 client secret from Developer Portal → OAuth2
DISCORD_CLIENT_SECRET=
# Must match an authorized redirect URL in the Discord Developer Portal
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Dashboard / API
SESSION_SECRET=
DATABASE_URL=./data/nexus.sqlite
PORT=3001
# Same URL as this service in production (e.g. https://nexus-discord-bot.onrender.com)
DASHBOARD_ORIGIN=http://localhost:5173

# Optional: only if Vercel UI and API are on different hosts
# VITE_API_BASE_URL=https://nexus-discord-bot.onrender.com
# CROSS_ORIGIN_DASHBOARD=true

# Optional: Discord user IDs (comma-separated) that always get dashboard manage access
# Useful when you have a cosmetic Owner role but are not Discord's technical server owner
# DASHBOARD_ADMIN_IDS=123456789012345678
