# Discord Bot Credentials
# Copy this file to .env and fill in your values
# NEVER commit your real .env file

DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Discord OAuth2 (Dashboard login)
# Application ID — usually same as CLIENT_ID
DISCORD_CLIENT_ID=
# Bot / OAuth2 client secret from Developer Portal → OAuth2
DISCORD_CLIENT_SECRET=
# Must match an authorized redirect URL in the Discord Developer Portal
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Dashboard / API
SESSION_SECRET=
DATABASE_URL=./data/nexus.sqlite
PORT=3001
# Frontend origin (Vercel URL in production, e.g. https://nexusdiscordbot.vercel.app)
DASHBOARD_ORIGIN=http://localhost:5173

# Frontend (dashboard/.env or Vercel env) — only needed when UI and API are on different hosts
# VITE_API_BASE_URL=https://your-api-host.example.com
